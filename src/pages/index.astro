---
// Главная = вся витрина. Трейлер-заставка → 3 полноэкранных слайда, листаются как презентация.
// Переход 1→2 — «сквозь замочную скважину» (CSS mask), 2→3 — шторка (clip-path).
// Дека включается, только если каждый слайд помещается в экран; иначе — обычная прокрутка.
import Base from '../layouts/Base.astro';
import CasePanel from '../components/CasePanel.astro';
import Split from '../components/Split.astro';
import { brand, hero, trailer, publishedCases, contact, reviews } from '../data/site';
const slides = [{ id: 'start', label: 'Старт' }, { id: 'work', label: 'Портфолио' }, { id: 'contact', label: 'Контакты' }];
const keyholePath = 'M43.5 56.8A18 18 0 1 1 56.5 56.8L63 86H37Z';
const B = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---
<Base
  title="КЛЮЧ — IT-агентство полного цикла: приложения, сайты, реклама, автоматизация"
  description="Открываем рост бизнеса: приложения, сайты, реклама и автоматизация. Проекты от 30 тыс. до 25 млн ₽. Работали для Циан, Toshiba, Сбербанка, ХК «Спартак»."
>
  <Fragment slot="head">
  <script is:inline>
      // До отрисовки: трейлер — раз в 7 дней (вернувшийся клиент сразу видит главный экран), не при «уменьшить движение»; ?intro — показать принудительно.
      (function () {
        var d = document.documentElement, show = true;
        try { show = Date.now() - (+localStorage.getItem('ks_trailer_at') || 0) > 6048e5 && !sessionStorage.getItem('ks_trailer'); } catch (e) {}
        if (/[?&]intro/.test(location.search)) show = true;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches || location.hash) show = false;
        d.classList.add(show ? 'trailer-on' : 'trailer-off');
        // Деку включаем до первой отрисовки (иначе экран «прыгает» — CLS); скрипт ниже проверит, влезают ли слайды, и при нужде выключит.
        if (innerHeight >= 600) { d.classList.add('deck-on'); d.dataset.slide = '0'; }
      })();
    </script>
  </Fragment>

  <button slot="bar" class="sound-toggle" id="sound-toggle" type="button" aria-pressed="false" aria-label="Звук">
    <span class="eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span class="sound-label">Звук</span>
  </button>

  <!-- ТРЕЙЛЕР -->
  <div class="trailer" id="trailer" aria-hidden="true">
    <div class="tr-line"></div>
    <!-- тайминги от старта (после загрузки шрифта): --t вход, --t2 уход, --st шаг волны по буквам -->
    {trailer.cuts.map((w, k) => <p class={`tr tr-cut tr-cut-${k % 3} has-out`} style={`--len:${w.length};--t:${(0.3 + k * trailer.step).toFixed(2)}s;--t2:${(0.3 + k * trailer.step + trailer.step * 0.7).toFixed(2)}s;--st:14ms;--st2:8ms;--di:.3s;--do:.2s`}><Split text={w} /></p>)}
    <div class="tr-progress"></div>
    <p class="tr tr-c tr-soft" style="--t:3.7s;--st:16ms;--di:.6s"><Split text={trailer.proof} /></p>
    <div class="tr-key">
      <svg viewBox="0 0 300 120" fill="none" aria-hidden="true">
        <circle class="tr-draw" pathLength="1" cx="60" cy="60" r="40" stroke="#E8B04B" stroke-width="3"/>
        <circle cx="60" cy="60" r="12" stroke="#3A3E45" stroke-width="3"/>
        <path class="tr-draw" pathLength="1" d="M100 60H290M262 60v32M240 60v20M218 60v12" stroke="#E8B04B" stroke-width="3"/>
      </svg>
      <span class="tr-word" style="--t:5.6s;--st:80ms;--di:.75s"><Split text={brand.name} /></span>
    </div>
    <button class="tr-sound" type="button" id="tr-sound"><span class="tr-eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span class="ts-d">Смотреть со звуком</span><span class="ts-m">Со звуком</span></button>
    <button class="tr-skip" type="button" id="tr-skip">Пропустить ›</button>
  </div>

  <main class="deck" id="deck" data-i="0">
    <!-- 1. СТАРТ -->
    <section class="slide s-start" id="start" aria-label="Старт">
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="slide-inner hero">
        <div class="kicker reveal">{hero.kicker}<span class="sep"> · </span><b class="nw">от {hero.range.from} до {hero.range.to}</b></div>
        <h1>
          <Split text={hero.titleStart} class="h1-a h1-small" />
          <span class="rot" aria-hidden="true">{hero.rotating.map((w, k) => <span class={`rw${k === 0 ? ' on' : ''}`}><Split text={w} /></span>)}</span>
          <span class="sr-only">{hero.rotating.join(' ')}</span>
        </h1>
        <p class="lead reveal">{hero.lead}</p>
        <div class="actions reveal">
          <a href="#contact" class="btn btn-primary" data-go="2" data-magnetic>{hero.cta}</a>
          <a href="#work" class="btn btn-ghost" data-go="1" data-magnetic>Портфолио</a>
        </div>
        <ul class="guarantees reveal" aria-label="Гарантии">{hero.guarantees.map((g) => <li>{g}</li>)}</ul>
        <div class="proof reveal">
          <span class="proof-label">{hero.proofLabel}</span>
          <a href="#work" class="proof-list" data-go="1">
            {publishedCases.map((c) => <span class="proof-name" style={`--brand:${c.theme.bg.startsWith('#') ? c.theme.bg : '#21A038'}`}>{c.client.replace('ХК «Спартак» Москва', '«Спартак»')} </span>)}<span class="sr-only">— смотреть портфолио</span>
          </a>
        </div>
        <p class="speed reveal" id="speed" aria-hidden="true"><span class="speed-dot" aria-hidden="true"></span><span id="speed-text"></span></p>
      </div>
      <div class="marquee" aria-hidden="true"><div class="marquee-track">
        {[0, 1].map(() => hero.pains.map((d) => <span>{d}</span>))}
      </div></div>
    </section>

    <!-- 2. ПОРТФОЛИО (раскрывается сквозь скважину) -->
    <section class="slide s-work" id="work" aria-label="Портфолио">
      <div class="zoom">
        <div class="slide-inner">
          <span class="ghost-num" aria-hidden="true">02</span>
          <div class="s-head">
            <div><div class="kicker reveal">02 / Портфолио</div><h2><Split text="Нам доверяют лидеры рынков" class="sh" /></h2></div>
          </div>
          <div class="panels reveal" id="panels">{publishedCases.map((c, i) => <CasePanel c={c} i={i} />)}</div>
        </div>
      </div>
    </section>

    <!-- скважина: над портфолио, пока мы на первом слайде -->
    <button class="keyhole" type="button" data-go="1">
      <svg viewBox="0 0 100 100" fill="none" aria-hidden="true"><path d={keyholePath} stroke="#E8B04B" stroke-width="1.2" vector-effect="non-scaling-stroke"/></svg>
      <span class="keyhole-label"><span class="kl-d">Загляните внутрь ↓</span><span class="kl-m">Открыть кейсы</span></span>
    </button>

    <!-- 3. КОНТАКТЫ (шторка) -->
    <section class="slide s-contact" id="contact" aria-label="Контакты">
      <div class="slide-inner contact">
        <div class="contact-main">
          <span class="ghost-num" aria-hidden="true">03</span>
          <div class="kicker reveal">03 / Контакты</div>
          <h2><span class="ln"><Split text={contact.titleA} class="sh" /></span><span class="ln acc"><Split text={contact.titleB} class="sh" start={contact.titleA.length} /></span></h2>
          <p class="lead reveal">{contact.lead}</p>
          <div class="big-links reveal">
            <a href={brand.telegram} rel="noopener" class="big-link" data-magnetic>Telegram <i>↗</i></a>
            <a href={brand.phoneHref} class="mid-link mid-phone">{brand.phone}</a>
            <a href={brand.telegram2} rel="noopener" class="mid-link mid-tg2">{brand.telegram2Label}</a>
            {reviews.map((r) => <a href={r.url} rel="noopener" class="mid-link">{r.label} ↗</a>)}
            {!brand.email.startsWith('[') && <a href={`mailto:${brand.email}`} class="mid-link mid-mail">{brand.email}</a>}
          </div>
        </div>
        <form class="form js-lead reveal" action={`${B}api/send.php`} method="post" novalidate data-tg={brand.telegram}>
          <div class="form-title">{contact.formTitle}</div>
          <p class="form-sla">{contact.sla}</p>
          <fieldset class="pains">
            <legend>{contact.painsLabel}</legend>
            <div class="pains-row">{hero.pains.map((p, k) => <label class="pain"><input type="checkbox" name="pains[]" value={p} id={`pain-${k}`}><span>{p}</span></label>)}</div>
          </fieldset>
          <div class="field"><input id="f-name" name="name" type="text" autocomplete="name" required minlength="2" placeholder=" "><label for="f-name">Как вас зовут</label><span class="field-msg">Минимум 2 буквы</span></div>
          <div class="field"><input id="f-contact" name="contact" type="text" autocomplete="tel" required pattern="^(\+?[0-9][0-9\s()\-]{9,}|@?[A-Za-z0-9_]{5,})$" placeholder=" "><label for="f-contact">Телефон или @telegram</label><span class="field-msg">Номер телефона или ник в Telegram</span></div>
          <input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">
          <label class="consent"><input type="checkbox" name="consent" value="1" required><span>Даю <a href={`${B}consent/`} target="_blank" rel="noopener">согласие на обработку персональных данных</a></span></label>
          <button type="submit" class="btn btn-primary" data-magnetic>Жду звонка</button>
          <p class="form-trust">{contact.trust.join(' · ')}</p>
          <div class="form-status" role="status" aria-live="polite"></div>
        </form>
      </div>
      <div class="legal">© {new Date().getFullYear()} {brand.name}{!brand.legal.startsWith('[') && ` · ${brand.legal}`} · <a href={`${B}privacy/`}>Политика ПДн</a></div>
    </section>
  </main>

  <nav class="dots" aria-label="Слайды">
    {slides.map((s, i) => <button class="dot" type="button" data-go={i} aria-current={i === 0 ? 'true' : 'false'}><span>{s.label}</span></button>)}
  </nav>
  <div class="counter" aria-hidden="true"><b id="cur">01</b> / 0{slides.length}</div>
  <div class="cursor" aria-hidden="true"></div>
  <div class="progress" aria-hidden="true"><span id="progress-bar"></span></div>
  <button class="scroll-hint" type="button" data-go="1" aria-label="Следующий экран">
    <span class="hint-mouse" aria-hidden="true"><i></i></span>
    <span class="hint-finger" aria-hidden="true"><svg viewBox="0 0 24 40" fill="none"><rect x="1" y="1" width="22" height="38" rx="11" stroke="currentColor" stroke-width="1.5" opacity=".35"/><circle cx="12" cy="28" r="5" fill="currentColor"/></svg></span>
    <span class="hint-text"><span class="hint-desk">Листайте</span><span class="hint-touch">Свайп вверх — кейсы</span></span>
  </button>

  <script>
    import { feel, setSound, isSoundOn, soundPreference, armSoundFromPreference, playTrailerScore, soundUnlocked } from '../scripts/feel';
    const root = document.documentElement;
    // Цели Яндекс Метрики (список и идентификаторы — в site.ts → analytics). Без номера счётчика ничего не отправляется.
    const ymId = Number(root.dataset.ym || 0);
    const sent = new Set<string>();
    const goal = (name: string, once = true) => {
      if (!ymId || (once && sent.has(name))) return; sent.add(name);
      try { (window as unknown as { ym?: (...a: unknown[]) => void }).ym?.(ymId, 'reachGoal', name); } catch {}
    };
    const deck = document.getElementById('deck')!;
    const slides = [...document.querySelectorAll<HTMLElement>('.slide')];
    const dots = [...document.querySelectorAll<HTMLButtonElement>('.dot')];
    const cur = document.getElementById('cur')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let i = 0, lock = false, on = false, playing = root.classList.contains('trailer-on');

    /* ---------- трейлер ---------- */
    let soundReady: () => void = () => {};
    let soundReady0: () => void = () => {};
    const trailerEl = document.getElementById('trailer')!;
    const endTrailer = () => {
      if (!playing) return; playing = false;
      try { sessionStorage.setItem('ks_trailer', '1'); localStorage.setItem('ks_trailer_at', String(Date.now())); } catch {}
      root.classList.add('trailer-out');
      setTimeout(() => { root.classList.remove('trailer-on', 'trailer-out'); root.classList.add('trailer-off'); trailerEl.remove(); }, 1300);
      startRotator(); setTimeout(() => root.classList.add('hero-in'), 250);
    };
    if (playing) {
      // Старт после загрузки шрифта (не дольше 700 мс), чтобы буквы не «прыгали» с системного шрифта.
      let tm = 0, goAt = 0;
      const begin = () => { if (root.classList.contains('tr-go')) return; root.classList.add('tr-go'); goAt = performance.now(); tm = window.setTimeout(() => { goal('trailer_full'); endTrailer(); }, 7200); };
      Promise.race([document.fonts?.ready, new Promise((r) => setTimeout(r, 700))]).then(begin);
      const skip = () => { clearTimeout(tm); goal('trailer_skip'); endTrailer(); };
      // Звук по умолчанию включён: партитура стартует, как только браузер разрешит звук (первое касание/клик/клавиша).
      // Первое касание трейлера — это и есть «включить звук», а не «пропустить». Пропуск — кнопкой, колесом, клавишей, свайпом.
      const soundBtn0 = document.getElementById('tr-sound')!;
      const t0 = () => (root.classList.contains('tr-go') ? (performance.now() - goAt) / 1000 : 0);
      const CUTS = [0, 1, 2, 3, 4].map((k) => 0.3 + k * 0.6);
      let scored = false;
      const startScore = () => { if (scored || !playing || !isSoundOn()) return; scored = true; playTrailerScore(t0(), CUTS); paintTr(); };
      const paintTr = () => {
        const on = isSoundOn() && soundUnlocked();
        soundBtn0.classList.toggle('on', on); soundBtn0.classList.toggle('wait', isSoundOn() && !soundUnlocked());
        soundBtn0.querySelector('.ts-d')!.textContent = on ? 'Выключить звук' : isSoundOn() ? 'Нажмите — включится звук' : 'Смотреть со звуком';
        soundBtn0.querySelector('.ts-m')!.textContent = on ? 'Без звука' : isSoundOn() ? 'Нажмите — звук' : 'Со звуком';
      };
      soundBtn0.addEventListener('click', (e) => {
        e.stopPropagation();
        const v = !(isSoundOn() && soundUnlocked());
        setSound(v); document.getElementById('sound-toggle')?.setAttribute('aria-pressed', String(v)); if (v) goal('sound_on');
        if (v) { scored = false; startScore(); }
        paintTr();
      });
      soundReady = () => { startScore(); paintTr(); };
      soundReady0 = paintTr;
      paintTr();
      const notSound = (e: Event) => !(e.target instanceof Element && e.target.closest('.tr-sound'));
      // Касание «съедается» (не пропускает трейлер), только если звук ещё не играл: оно его и включает.
      let swallow = false;
      // Состояние снимаем ДО того, как это же касание включит звук (слушатель на window в фазе захвата, зарегистрирован раньше).
      const mark = (e: Event) => { if (e.target instanceof Node && trailerEl.contains(e.target) && soundPreference() && !soundUnlocked()) swallow = true; };
      addEventListener('pointerdown', mark, true); addEventListener('touchstart', mark, { capture: true, passive: true });
      document.getElementById('tr-skip')!.addEventListener('click', (e) => { e.stopPropagation(); skip(); });
      trailerEl.addEventListener('click', (e) => { if (!notSound(e)) return; if (swallow) { swallow = false; return; } skip(); });
      addEventListener('wheel', () => playing && skip(), { passive: true });
      let ty0 = 0;
      addEventListener('touchstart', (e) => { ty0 = e.touches[0].clientY; }, { passive: true });
      addEventListener('touchend', (e) => { if (playing && Math.abs(e.changedTouches[0].clientY - ty0) > 50) skip(); }, { passive: true });
      window.addEventListener('keydown', (e) => { if (playing && notSound(e)) { e.preventDefault(); skip(); } });
    } else { trailerEl.remove(); }

    /* ---------- дека ---------- */
    // Подгонка под экран: если слайд выше видимой области (панели Safari, низкий телефон), его содержимое
    // уменьшается (zoom), а не выключается режим презентации. Раньше дека выключалась → вёрстка «ехала», свайп не работал.
    const MIN_FIT = 0.68;
    const fits = () => {
      let worst = 1;
      slides.forEach((s) => {
        const inner = s.querySelector<HTMLElement>('.slide-inner')!;
        inner.style.removeProperty('zoom');
        const cs = getComputedStyle(s);
        const avail = window.innerHeight - parseFloat(cs.paddingTop) - parseFloat(cs.paddingBottom);
        const k = Math.min(1, avail / inner.scrollHeight);
        worst = Math.min(worst, k);
        if (k < 0.995) inner.style.zoom = (Math.floor(k * 1000) / 1000).toFixed(3);
      });
      if (worst < MIN_FIT) slides.forEach((s) => s.querySelector<HTMLElement>('.slide-inner')!.style.removeProperty('zoom'));
      return worst >= MIN_FIT;
    };
    // «Печатает» — только текстовые поля. Чекбоксы (в т.ч. скрытый переключатель вибрации iOS) — не в счёт.
    const typing = () => { const a = document.activeElement; return !!a && a.matches('input:not([type=checkbox]):not([type=radio]):not([type=submit]):not([type=button]), textarea, select'); };
    // Телефон: скважина встаёт в свободное место между шапкой и текстом (текст прижат к низу и его высота разная),
    // иначе она ложится поверх заголовка. Те же --kx/--ky/--ks использует маска перехода и растворение трейлера.
    const placeKey = () => {
      const st = root.style;
      if (innerWidth > 900 || !on) { ['--kx', '--ky', '--ks'].forEach((p) => st.removeProperty(p)); root.classList.remove('no-key'); return; }
      root.classList.remove('no-key');                                // со скважиной подсказка свайпа не нужна → текст ниже, места больше
      const barB = document.querySelector('.bar')!.getBoundingClientRect().bottom;
      const heroT = document.querySelector('.s-start .slide-inner')!.getBoundingClientRect().top;
      const room = heroT - barB - 12, LABEL = 40;                     // под скважиной — кнопка-подпись «Открыть кейсы»
      const k = Math.max(64, Math.min(170, innerWidth * 0.42, (room - LABEL) * 0.95));
      root.classList.toggle('no-key', room - LABEL < 64);
      const top = barB + 6 + (room - k - LABEL) / 2;
      st.setProperty('--ks', `${k}px`); st.setProperty('--kx', `${innerWidth / 2}px`);
      st.setProperty('--ky', `${top + k * 0.4}px`);
    };
    function apply() {
      if (typing()) return;
      root.classList.remove('deck-on');
      on = fits();
      root.classList.toggle('deck-on', on);
      placeKey();
      go(i, true);
    }
    let kTimer = 0;
    function go(n: number, instant = false) {
      const was = i;
      i = Math.max(0, Math.min(slides.length - 1, n));
      // Маска-скважина: снята, пока мы за дверью; перед возвратом на первый слайд — вернуть (в большом размере), потом сжать.
      clearTimeout(kTimer);
      if (i === 0 && deck.classList.contains('k-open')) { deck.classList.remove('k-open'); void deck.offsetWidth; }
      if (i > 0) kTimer = window.setTimeout(() => deck.classList.add('k-open'), instant || was > 0 ? 0 : 1300);
      if (!on) { slides.forEach((s) => { s.classList.add('is-active'); s.removeAttribute('inert'); }); if (!instant) slides[i].scrollIntoView({ behavior: reduce ? 'auto' : 'smooth' }); return; }
      if (instant) { root.classList.add('no-anim'); requestAnimationFrame(() => requestAnimationFrame(() => root.classList.remove('no-anim'))); }
      deck.dataset.i = String(i); root.dataset.slide = String(i);
      slides.forEach((s, k) => { s.classList.toggle('is-active', k === i); s.toggleAttribute('inert', k !== i); });
      dots.forEach((d, k) => d.setAttribute('aria-current', String(k === i)));
      cur.textContent = String(i + 1).padStart(2, '0');
      history.replaceState(null, '', i ? `#${slides[i].id}` : location.pathname + location.search);
    }
    const progress = document.getElementById('progress-bar')!;
    const setProgress = () => (progress.style.transform = `scaleX(${(i + 1) / slides.length})`);
    // Отклик на смену слайда: вход сквозь скважину — «поворот ключа», шторка — шелест, остальное — шаг.
    const feelFor = (from: number, to: number) => {
      if (from === 0 && to === 1) feel('unlock'); else if (to === 2) feel('curtain'); else feel('step', to > from ? 1 : -1);
    };
    const goFeel = (n: number) => {
      if (!on || playing) return false;
      const from = i; if (n === from || n < 0 || n >= slides.length) return false;
      lock = true; go(n); feelFor(from, n); setProgress(); root.classList.add('hint-used');
      goal(n === 1 ? 'portfolio' : n === 2 ? 'contacts' : 'start');
      setTimeout(() => (lock = false), 900); return true;   // быстрый повторный свайп не «теряется»
    };
    // Один жест = один шаг: возвращает 'moved' | 'edge' | 'busy'.
    const step = (d: number) => {
      if (!on || lock || playing || typing()) return 'busy';
      const n = i + d; if (n < 0 || n >= slides.length) { feel('edge'); return 'edge'; }
      goFeel(n); return 'moved';
    };

    // Колесо и трекпад: жест = серия событий без пауз > 220 мс. Шагаем один раз за жест —
    // инерция трекпада больше не перелистывает два слайда.
    let wheelAcc = 0, lastWheel = 0, gestureUsed = false;
    window.addEventListener('wheel', (e) => {
      if (!on) return; e.preventDefault();
      const now = performance.now();
      if (now - lastWheel > 220) { gestureUsed = false; wheelAcc = 0; }
      lastWheel = now; wheelAcc += e.deltaY;
      if (!gestureUsed && Math.abs(wheelAcc) > 25) { gestureUsed = true; step(wheelAcc > 0 ? 1 : -1); }
    }, { passive: false });
    window.addEventListener('keydown', (e) => {
      if (!on || playing || typing()) return;
      if (['ArrowDown', 'PageDown', ' '].includes(e.key)) { e.preventDefault(); step(1); }
      if (['ArrowUp', 'PageUp'].includes(e.key)) { e.preventDefault(); step(-1); }
    });

    // Свайп: слайд тянется за пальцем с сопротивлением; на пороге — щелчок; у края — «резинка».
    const THRESHOLD = 64;
    let y0: number | null = null, x0 = 0, armed = false, dragging = false;
    const setDrag = (px: number) => deck.style.setProperty('--drag', `${px}px`);
    window.addEventListener('touchstart', (e) => {
      if (!on || playing || typing() || e.touches.length > 1) return;
      y0 = e.touches[0].clientY; x0 = e.touches[0].clientX; armed = false; dragging = false;
      root.classList.add('dragging');
    }, { passive: true });
    window.addEventListener('touchmove', (e) => {
      if (y0 === null) return;
      const dy = y0 - e.touches[0].clientY, dx = x0 - e.touches[0].clientX;
      if (!dragging && Math.abs(dx) > Math.abs(dy)) return;      // горизонтальные жесты не трогаем
      dragging = true; e.preventDefault();
      const atEdge = (dy > 0 && i === slides.length - 1) || (dy < 0 && i === 0);
      const k = atEdge ? 0.14 : 0.32;                             // у края сильнее сопротивление
      setDrag(Math.max(-90, Math.min(90, -dy * k)));
      const nowArmed = !atEdge && Math.abs(dy) > THRESHOLD;
      if (nowArmed !== armed) { armed = nowArmed; root.classList.toggle('armed', armed); if (armed) feel('tick'); }
    }, { passive: false });
    window.addEventListener('touchend', (e) => {
      if (y0 === null) return;
      const dy = y0 - e.changedTouches[0].clientY; y0 = null;
      root.classList.remove('dragging', 'armed'); setDrag(0);
      if (!dragging) return;
      if (Math.abs(dy) > THRESHOLD) step(dy > 0 ? 1 : -1);
      else if (Math.abs(dy) > 30 && ((dy > 0 && i === slides.length - 1) || (dy < 0 && i === 0))) feel('edge');
    }, { passive: true });
    document.querySelectorAll<HTMLElement>('[data-go]').forEach((el) => el.addEventListener('click', (e) => {
      e.preventDefault(); if (playing) return;
      if (!on) { go(Number(el.dataset.go)); return; }
      goFeel(Number(el.dataset.go));
    }));
    // Браузер прокручивает слайд к полю с ошибкой или к фокусу — в режиме презентации это сдвигает экран.
    // Горизонтальный сдвиг запрещён всегда; вертикальный — только пока человек печатает (клавиатура телефона).
    addEventListener('scroll', (e) => {
      const t = e.target;
      if (!on || !(t instanceof HTMLElement) || !(t === deck || t.classList.contains('slide') || t.classList.contains('zoom'))) return;
      if (t.scrollLeft) t.scrollLeft = 0;
      if (t.scrollTop && !typing()) t.scrollTop = 0;
    }, true);
    addEventListener('focusout', () => setTimeout(() => { if (on && !typing()) slides.forEach((s) => { s.scrollTop = 0; s.scrollLeft = 0; }); }, 60));
    const start = slides.findIndex((s) => `#${s.id}` === location.hash);
    if (start > 0) i = start;
    let t: number; window.addEventListener('resize', () => { clearTimeout(t); t = window.setTimeout(apply, 150); });
    // Пока идёт трейлер, деку уже включил head-скрипт: проверку «влезает ли» делаем один раз, после загрузки шрифтов
    // (каждая проверка — полный пересчёт раскладки, ~100 мс на слабом телефоне).
    if (playing && document.fonts) { document.fonts.ready.then(apply); } else { apply(); document.fonts?.ready.then(apply); }
    setProgress();

    /* ---------- меняющееся слово ---------- */
    let rotStarted = false;
    function startRotator() {
      if (rotStarted || reduce) return; rotStarted = true;
      const words = [...document.querySelectorAll<HTMLElement>('.rot .rw')];
      let k = 0;
      setInterval(() => {
        if (document.hidden) return;
        words[k].classList.remove('on'); words[k].classList.add('off');
        const prev = words[k]; setTimeout(() => prev.classList.remove('off'), 900);
        k = (k + 1) % words.length; words[k].classList.add('on');
      }, 2400);
    }
    if (!playing) { startRotator(); root.classList.add('hero-in'); }

    /* ---------- портфолио: раскрывающиеся панели ---------- */
    const panels = [...document.querySelectorAll<HTMLElement>('.panel')];
    const openPanel = (p: HTMLElement) => { if (p !== panels[0] || p.dataset.seen) goal('case_open'); p.dataset.seen = '1'; panels.forEach((x) => x.classList.toggle('open', x === p)); };
    panels.forEach((p) => {
      p.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') openPanel(p); });
      p.addEventListener('focus', () => { if (p.matches(':focus-visible')) openPanel(p); });
      p.addEventListener('click', () => { if (!p.classList.contains('open')) { openPanel(p); feel('open'); } });
    });

    /* ---------- фонарик, курсор, магнитные кнопки (только мышь) ---------- */
    if (matchMedia('(pointer: fine)').matches && !reduce) {
      const cursor = document.querySelector<HTMLElement>('.cursor')!;
      let mx = innerWidth / 2, my = innerHeight / 2, cx = mx, cy = my;
      window.addEventListener('mousemove', (e) => {
        mx = e.clientX; my = e.clientY;
        root.style.setProperty('--mx', `${mx}px`); root.style.setProperty('--my', `${my}px`);
        const h = (e.target as HTMLElement).closest('a,button,.panel,label,input');
        cursor.classList.toggle('hover', !!h); cursor.classList.remove('away');
      });
      document.addEventListener('mouseleave', () => cursor.classList.add('away'));
      // Скважина «смотрит» на мышь: свет за дверью и сама скважина смещаются (те же --tx/--ty, что у наклона телефона).
      // Экономно: центр скважины считаем при смене размера, а не каждый кадр; переменные пишем, только пока они меняются
      // (запись в корень пересчитывает стили страницы — иначе на слабом телефоне подтормаживает).
      let tx = 0, ty = 0, kcx = 0, kcy = 0, wx = '', wy = '';
      const keyEl = document.querySelector<HTMLElement>('.keyhole');
      const measureKey = () => { if (!keyEl) return; const r = keyEl.getBoundingClientRect(); kcx = r.left + r.width / 2; kcy = r.top + r.height * 0.4; };
      addEventListener('resize', () => setTimeout(measureKey, 200)); setTimeout(measureKey, 300);
      const loop = () => {
        if (Math.abs(mx - cx) + Math.abs(my - cy) > 0.3) { cx += (mx - cx) * 0.2; cy += (my - cy) * 0.2; cursor.style.transform = `translate(${cx}px, ${cy}px)`; }
        if (keyEl && i === 0 && !playing && kcx) {
          const gx = Math.max(-1, Math.min(1, (mx - kcx) / (innerWidth * 0.45)));
          const gy = Math.max(-1, Math.min(1, (my - kcy) / (innerHeight * 0.45)));
          tx += (gx - tx) * 0.06; ty += (gy - ty) * 0.06;
          const nx = tx.toFixed(2), ny = ty.toFixed(2);
          if (nx !== wx) { root.style.setProperty('--tx', nx); wx = nx; }
          if (ny !== wy) { root.style.setProperty('--ty', ny); wy = ny; }
        }
        requestAnimationFrame(loop);
      };
      root.classList.add('has-cursor', 'tilt'); loop();
      document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((el) => {
        el.addEventListener('mousemove', (e) => {
          const r = el.getBoundingClientRect();
          el.style.transform = `translate(${(e.clientX - r.left - r.width / 2) * 0.18}px, ${(e.clientY - r.top - r.height / 2) * 0.3}px)`;
        });
        el.addEventListener('mouseleave', () => (el.style.transform = ''));
      });
    }

    /* ---------- живое доказательство: скорость загрузки у самого посетителя ---------- */
    addEventListener('load', () => setTimeout(() => {
      const nav = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
      const paint = performance.getEntriesByName('first-contentful-paint')[0];
      const ms = paint ? paint.startTime : nav ? nav.domContentLoadedEventEnd : 0;
      if (!ms || ms > 1800) return;                                   // хвастаемся только реальной скоростью
      const sec = (ms / 1000).toFixed(1).replace('.', ',');
      document.getElementById('speed-text')!.textContent = innerWidth <= 640
        ? `Открылся у вас за ${sec} с — так же сделаем ваш`         // на телефоне — в одну строку
        : `Этот сайт открылся у вас за ${sec} с — так же быстро сделаем ваш`;
      const sp = document.getElementById('speed')!; sp.classList.add('on'); sp.removeAttribute('aria-hidden');
    }, 0));

    /* ---------- звук ---------- */
    const soundBtn = document.getElementById('sound-toggle')!;
    const paintSound = () => { soundBtn.setAttribute('aria-pressed', String(isSoundOn())); };
    soundBtn.addEventListener('click', () => { const v = !(isSoundOn()); setSound(v); paintSound(); if (v) { feel('press'); goal('sound_on'); } });
    armSoundFromPreference(() => { soundReady(); paintSound(); }); paintSound(); soundReady0();

    /* ---------- нажатия кнопок ---------- */
    document.querySelectorAll<HTMLElement>('.btn, .big-link, .keyhole, .dot').forEach((el) =>
      el.addEventListener('pointerdown', () => { if (!el.matches('[data-go]')) feel('press'); }));

    /* ---------- телефон: палец — фонарик, наклон — свет в скважине ---------- */
    if (matchMedia('(pointer: coarse)').matches && !reduce) {
      const light = (x: number, y: number) => { root.style.setProperty('--mx', `${x}px`); root.style.setProperty('--my', `${y}px`); };
      addEventListener('touchstart', (e) => light(e.touches[0].clientX, e.touches[0].clientY), { passive: true });
      addEventListener('touchmove', (e) => light(e.touches[0].clientX, e.touches[0].clientY), { passive: true });
      let tx = 0, ty = 0, gx = 0, gy = 0, tiltOn = false;
      const onTilt = (e: DeviceOrientationEvent) => {
        if (e.gamma == null || e.beta == null) return;
        gx = Math.max(-1, Math.min(1, e.gamma / 25));
        gy = Math.max(-1, Math.min(1, (e.beta - 45) / 25));
        if (!tiltOn) { tiltOn = true; root.classList.add('tilt'); requestAnimationFrame(loop); }
      };
      const loop = () => {
        tx += (gx - tx) * 0.08; ty += (gy - ty) * 0.08;
        root.style.setProperty('--tx', tx.toFixed(3)); root.style.setProperty('--ty', ty.toFixed(3));
        requestAnimationFrame(loop);
      };
      type DOE = typeof DeviceOrientationEvent & { requestPermission?: () => Promise<string> };
      const DO = (window as unknown as { DeviceOrientationEvent?: DOE }).DeviceOrientationEvent;
      // iOS требует разрешение на датчик движения — системное окно мешало (видео владельца 15.10). На iOS наклон не используем.
      if (DO && typeof DO.requestPermission !== 'function') addEventListener('deviceorientation', onTilt);
    }

    /* ---------- цели: клики по контактам и главной кнопке ---------- */
    document.addEventListener('click', (e) => {
      const a = (e.target as Element).closest?.('a'); if (!a) return;
      if (a.href.startsWith('https://t.me/')) goal('telegram', false);
      else if (a.href.startsWith('tel:')) goal('phone', false);
      else if (a.matches('.btn-primary[data-go="2"]')) goal('cta');
    }, true);

    /* ---------- заявка ---------- */
    try { if (new URLSearchParams(location.search).get('utm_source')) sessionStorage.setItem('ks_utm', location.search); } catch {}
    document.querySelectorAll<HTMLFormElement>('form.js-lead').forEach((form) => {
      const status = form.querySelector<HTMLElement>('.form-status');
      // Проверка своя (novalidate): системные подсказки браузера говорят на языке браузера и выглядят чужеродно.
      const inputs = [...form.querySelectorAll<HTMLInputElement>('.field input')];
      const consent = form.querySelector<HTMLInputElement>('input[name="consent"]');
      const mark = (el: HTMLInputElement) => { const bad = !el.checkValidity();
        const msg = el.parentElement?.querySelector<HTMLElement>('.field-msg');
        if (msg) { msg.dataset.hint ??= msg.textContent || ''; msg.textContent = el.value.trim() ? msg.dataset.hint : 'Заполните поле'; }
        (el.type === 'checkbox' ? el.closest('.consent')! : el).classList.toggle('bad', bad); return !bad; };
      inputs.forEach((el) => {
        el.addEventListener('blur', () => { if (el.value) mark(el); });
        el.addEventListener('input', () => { if (el.classList.contains('bad')) mark(el); });
      });
      consent?.addEventListener('change', () => mark(consent));
      const showFallback = () => {
        if (!status) return;
        const tg = form.dataset.tg || '';
        status.innerHTML = 'Это демо-версия сайта — заявки здесь не принимаются. ' + (tg.length > 13 ? `<a href="${tg}" rel="noopener">Напишите нам в Telegram ↗</a>` : 'Контакты появятся при запуске.');
      };
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const bad = [...inputs, ...(consent ? [consent] : [])].filter((el) => !mark(el));
        if (bad.length) {
          feel('error'); goal('form_error');
          if (status) status.textContent = bad[0] === consent ? 'Отметьте согласие на обработку данных.' : 'Проверьте выделенные поля.';
          bad[0].focus({ preventScroll: true });
          return;
        }
        const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        if (btn) btn.disabled = true;
        if (status) status.textContent = 'Отправляем…';
        const fd = new FormData(form);
        fd.append('page', location.pathname);
        try { fd.append('utm', sessionStorage.getItem('ks_utm') || ''); } catch {}
        try {
          const r = await fetch(form.action, { method: 'POST', body: fd });
          // Нет PHP (GitHub Pages, статичный хостинг): сервер отдаёт 404/405 или сам файл вместо JSON.
          if ([404, 405, 501].includes(r.status) || !(r.headers.get('content-type') || '').includes('json')) { showFallback(); if (btn) btn.disabled = false; return; }
          const j = await r.json().catch(() => ({}));
          if (r.ok && j.ok) { feel('success'); goal('lead', false); await new Promise((ok) => setTimeout(ok, 350)); const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/'; location.href = base + 'thanks/' + (j.id ? `?n=${encodeURIComponent(j.id)}` : ''); return; }
          feel('error'); if (status) status.textContent = 'Не удалось отправить. Напишите нам в Telegram или позвоните.';
        } catch { feel('error'); if (status) status.textContent = 'Нет связи. Напишите нам в Telegram или позвоните.'; }
        if (btn) btn.disabled = false;
      });
    });
  </script>
</Base>
