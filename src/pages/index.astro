      // Телефон: живые карточки занимают ровно свободное место над текстом (до 250 px); меньше 150 px — карточек нет.
      const cards = s.querySelector<HTMLElement>('.hero > .of-cards');
      if (cards) {
        cards.style.removeProperty('display'); cards.style.removeProperty('height');
        if (innerWidth <= 900) {
          cards.style.height = '0px';
          const h = Math.min(250, avail - inner.scrollHeight - 6);
          if (h < 150) cards.style.display = 'none'; else cards.style.height = `${Math.floor(h)}px`;
        }
      }
      const k = Math.min(1, avail / inner.scrollHeight);
      if (k < 0.995) inner.style.zoom = (Math.floor(Math.max(k, floor) * 1000) / 1000).toFixed(3);
