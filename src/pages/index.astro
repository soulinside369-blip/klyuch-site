      let tx = 0, ty = 0, kcx = 0, kcy = 0, wx = '', wy = '';
      const keyEl = document.querySelector<HTMLElement>('.of-cards');
      const measureKey = () => { if (!keyEl) return; const r = keyEl.getBoundingClientRect(); kcx = r.left + r.width / 2; kcy = r.top + r.height * 0.5; };
      addEventListener('resize', () => setTimeout(measureKey, 200)); setTimeout(measureKey, 300);
      const frame = () => {
        raf = 0;
        if (i !== 0 || playing) return;
        start.style.setProperty('--mx', `${mx}px`); start.style.setProperty('--my', `${my}px`);
        if (!keyEl || !kcx) return;
        const gx = Math.max(-1, Math.min(1, (mx - kcx) / (innerWidth * 0.45)));
        const gy = Math.max(-1, Math.min(1, (my - kcy) / (innerHeight * 0.45)));
