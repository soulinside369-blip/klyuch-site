    if (playing && document.fonts) { document.fonts.ready.then(apply); } else { apply(); document.fonts?.ready.then(apply); }
    setProgress();

    /* ---------- карусель офферов: часы — анимация полоски активной вкладки (пауза = пауза анимации) ---------- */
    if (!playing) root.classList.add('hero-in');
    {
      const box = document.getElementById('offers');
      const tabs = [...document.querySelectorAll<HTMLButtonElement>('.of-tab')];
      const panes = [...document.querySelectorAll<HTMLElement>('.of')];
      const cta = document.getElementById('hero-cta');
      const pauseBtn = document.getElementById('of-pause');
      const cards = [...document.querySelectorAll<HTMLElement>('.oc')];
      let k = 0;
      const show = (n: number, user = false) => {
