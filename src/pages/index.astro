        }, { passive: true });
        deckCards?.addEventListener('click', () => { if (swiped) { swiped = false; return; } cta?.click(); });
      }
      box?.addEventListener('animationend', (e) => { if ((e.target as HTMLElement).classList.contains('of-bar')) show((k + 1) % panes.length); });
      box?.addEventListener('focusin', (e) => { if ((e.target as HTMLElement).matches(':focus-visible')) box.classList.add('hold'); });
      box?.addEventListener('focusout', () => box.classList.remove('hold'));
