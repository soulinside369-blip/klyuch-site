    const viewH = () => Math.min(innerHeight, window.visualViewport && !typing() ? visualViewport.height : innerHeight);
    const fitOne = (s: HTMLElement, floor = 0) => {
      const inner = s.querySelector<HTMLElement>('.slide-inner')!;
