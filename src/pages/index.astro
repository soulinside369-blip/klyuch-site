      const box = [...document.querySelectorAll<HTMLInputElement>('.pains input')].find((x) => x.value === el.dataset.pain);
      if (box) box.checked = true;
    }));

    /* ---------- расчёт: три ответа поворачивают кольца замка; запрос сразу кладётся в форму ---------- */
    {
      const pick: Record<string, string> = {};
      const lock = document.getElementById('lock'), sum = document.getElementById('calc-sum');
      const brief = document.getElementById('form-brief');
      const hid = (n: string) => document.querySelector<HTMLInputElement>(`form.js-lead input[type=hidden][name="${n}"]`);
      document.querySelectorAll<HTMLInputElement>('.s-calc input[type=radio]').forEach((inp) => inp.addEventListener('change', () => {
        const key = inp.name.slice(2), first = !pick[key]; pick[key] = inp.value;
        lock?.querySelector(`[data-ring="${key}"]`)?.classList.add('on');
        const parts = ['service', 'budget', 'term'].map((k) => pick[k]).filter(Boolean);
        const done = parts.length === 3;
        if (sum) sum.innerHTML = `<b>${parts.join(' · ')}</b>${done ? `<span>${sum.dataset.ready}</span>` : ''}`;
        if (done && !lock?.classList.contains('open')) { lock?.classList.add('open'); feel('unlock'); goal('calc_done'); } else if (first) feel('tick');
        const s = hid('service'), b = hid('budget'), t = hid('task');
        if (s) s.value = pick.service || ''; if (b) b.value = pick.budget || ''; if (t) t.value = pick.term ? `Срок: ${pick.term}` : '';
        if (brief) { brief.hidden = false; brief.querySelector('span')!.textContent = parts.join(' · '); }
      }));
    }

    /* ---------- портфолио: раскрывающиеся панели ---------- */
    const panels = [...document.querySelectorAll<HTMLElement>('.panel')];
    const openPanel = (p: HTMLElement) => { if (p !== panels[0] || p.dataset.seen) goal('case_open'); p.dataset.seen = '1'; panels.forEach((x) => x.classList.toggle('open', x === p)); };
    panels.forEach((p) => {
      p.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') openPanel(p); });
      p.addEventListener('focus', () => { if (p.matches(':focus-visible')) openPanel(p); });
      p.addEventListener('click', () => { if (!p.classList.contains('open')) { openPanel(p); feel('open'); } });
    });

    /* ---------- фонарик, курсор, магнитные кнопки (только мышь) ----------
       Скорость (18.11, «всё в замедленном действии»): свой курсор убран — системный рисуется без задержки;
       переменные пишем не в корень (это пересчёт стилей всей страницы), а только в первый слайд;
