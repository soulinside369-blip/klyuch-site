---
import Base from '../layouts/Base.astro';
import { brand } from '../data/site';
const B = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---
<Base title="Политика обработки персональных данных — КЛЮЧ" description="Политика обработки персональных данных и согласие на обработку.">
  <main class="page"><div class="inner">
    <a href={B} class="kicker" style="text-decoration:none">← На главную</a>
    <h1>Политика обработки персональных данных</h1>
    <p><b>ЧЕРНОВИК-КАРКАС. Текст готовит юрист по 152-ФЗ; ниже — только структура разделов.</b></p>
    <h2>1. Оператор</h2><p>{brand.legal}, {brand.address}.</p>
    <h2>2. Какие данные обрабатываем</h2><p>[Имя, контакт, описание задачи из формы; технические данные Яндекс Метрики.]</p>
    <h2>3. Цели и правовые основания</h2><p>[…]</p>
    <h2>4. Сроки хранения и уничтожение</h2><p>[…]</p>
    <h2>5. Передача третьим лицам</h2><p>[…]</p>
    <h2>6. Права субъекта и как с нами связаться</h2><p>[…] {brand.email}</p>
    <h2>7. Cookie и аналитика</h2><p>[…]</p>
    <h2 id="consent">Согласие на обработку персональных данных</h2><p>[Отдельный текст согласия — готовит юрист.]</p>
  </div></main>
</Base>
