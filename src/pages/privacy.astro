---
import Base from '../layouts/Base.astro';
import LegalDoc from '../components/LegalDoc.astro';
import { policy, legalVersion } from '../data/legal';
const B = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---
<Base title="Политика обработки персональных данных — КЛЮЧ" description="Как агентство КЛЮЧ обрабатывает и защищает персональные данные по 152-ФЗ.">
  <main class="page"><div class="inner">
    <a href={B} class="kicker" style="text-decoration:none">← На главную</a>
    <h1>Политика обработки персональных данных</h1>
    <p class="doc-meta">Редакция от {legalVersion} · <a href={`${B}consent/`}>Согласие на обработку данных</a></p>
    <LegalDoc blocks={policy} />
  </div></main>
</Base>
