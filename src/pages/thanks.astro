---
import Base from '../layouts/Base.astro';
import { brand } from '../data/site';
const B = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
// Скважина — та же форма, что на главной: ключ повернулся, дверь открыта.
const keyhole = 'M43.5 56.8A18 18 0 1 1 56.5 56.8L63 86H37Z';
---
<Base title="Заявка принята — КЛЮЧ" description="Спасибо за заявку." noindex>
  <main class="slide thanks">
    <div class="slide-inner">
      <div class="thanks-key" aria-hidden="true">
        <svg viewBox="0 0 100 100" fill="none"><path d={keyhole} stroke="#E8B04B" stroke-width="1.4" vector-effect="non-scaling-stroke"/></svg>
      </div>
      <div class="kicker">Заявка принята</div>
      <h1 class="thanks-title">Ключ повернулся.<br><span>Задача у нас.</span></h1>
      <p class="thanks-lead">Свяжемся в течение {brand.responseTime}: уточним детали и пришлём план решения со сроками и вилкой бюджета.</p>
      <div class="actions thanks-actions">
        <a href={brand.telegram} class="btn btn-primary" rel="noopener">Написать в Telegram</a>
        <a href={B} class="btn btn-ghost">На главную</a>
      </div>
    </div>
  </main>
</Base>

<style>
  .thanks { align-items: center; text-align: center; }
  .thanks .slide-inner { max-width: 760px; }
  .thanks-key { position: relative; width: 120px; height: 120px; margin: 0 auto 28px; }
  .thanks-key::before { content: ''; position: absolute; inset: -60%; border-radius: 50%;
    background: radial-gradient(circle, rgba(232,176,75,.35), transparent 62%); animation: glow 3.5s ease-in-out infinite; }
  .thanks-key svg { position: relative; width: 100%; height: 100%; filter: drop-shadow(0 0 16px rgba(232,176,75,.7));
    animation: turn 1.4s cubic-bezier(.22,1,.36,1) .2s both; transform-origin: 50% 40%; }
  .thanks-title { margin: 18px 0 0; font: 700 clamp(34px, 6vw, 76px)/1.02 var(--display); letter-spacing: -1.5px; }
  .thanks-title span { color: var(--accent); }
  .thanks-lead { margin: 22px auto 0; max-width: 520px; color: var(--dim); font-size: 17px; }
  .thanks-actions { justify-content: center; }
  @keyframes turn { from { opacity: 0; transform: rotate(-90deg) scale(.6); } to { opacity: 1; transform: none; } }
  @keyframes glow { 50% { opacity: .55; transform: scale(.92); } }
</style>
