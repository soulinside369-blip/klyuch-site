---
import Base from '../layouts/Base.astro';
const B = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---
<Base title="Страница не найдена — КЛЮЧ" description="Страница не найдена." noindex>
  <main class="slide"><div class="slide-inner">
    <div class="kicker">404</div>
    <h1 style="margin:20px 0 0;font:700 clamp(32px,5vw,72px)/1.05 var(--display)">Этой двери нет. Подберём другой ключ</h1>
    <div class="actions"><a href={B} class="btn btn-primary">На главную</a></div>
  </div></main>
</Base>
