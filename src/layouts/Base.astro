---
// Только кириллица и латиница. latin-ext не грузим: ради одного знака ₽ это +110 КБ — ₽ рисует системный шрифт.
import '@fontsource/unbounded/cyrillic-500.css';
import '@fontsource/unbounded/latin-500.css';
import '@fontsource/unbounded/cyrillic-700.css';
import '@fontsource/unbounded/latin-700.css';
import '@fontsource/manrope/cyrillic-400.css';
import '@fontsource/manrope/latin-400.css';
import '@fontsource/manrope/cyrillic-700.css';
import '@fontsource/manrope/latin-700.css';
import '@fontsource/jetbrains-mono/cyrillic-400.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import unbounded700 from '@fontsource/unbounded/files/unbounded-cyrillic-700-normal.woff2?url';
import unbounded500 from '@fontsource/unbounded/files/unbounded-cyrillic-500-normal.woff2?url';
import manrope400 from '@fontsource/manrope/files/manrope-cyrillic-400-normal.woff2?url';
import '../styles/global.css';
import { brand, analytics } from '../data/site';
const ym = /^\d+$/.test(analytics.metrikaId) ? analytics.metrikaId : '';

interface Props { title: string; description: string; noindex?: boolean; schema?: Record<string, unknown>[]; }
const { title, description, noindex = false, schema = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const org = {
  '@context': 'https://schema.org', '@type': 'ProfessionalService', name: brand.name, url: Astro.site?.href,
  priceRange: '30000 ₽ – 25000000 ₽', areaServed: 'RU',
  // Контакты — только реальные (заглушки «[…]» в разметку поисковиков не попадают).
  ...(brand.phone.startsWith('[') ? {} : { telephone: brand.phoneHref.replace('tel:', '') }),
  ...(brand.telegram.length > 13 ? { sameAs: [brand.telegram] } : {}),
  knowsAbout: ['Разработка мобильных приложений', 'Разработка сайтов', 'Контекстная реклама', 'Маркетинг', 'Автоматизация бизнеса', 'IT-консалтинг'],
};
const B = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---
<!doctype html>
<html lang="ru" style="background:#0B0C0E" data-ym={ym || undefined}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  {noindex && <meta name="robots" content="noindex">}
  <meta name="theme-color" content="#0B0C0E">
  <meta name="color-scheme" content="dark">
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:locale" content="ru_RU">
  <meta property="og:site_name" content="КЛЮЧ">
  <meta property="og:image" content={new URL(`${B}og.jpg`, Astro.site).href}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content={new URL(`${B}og.jpg`, Astro.site).href}>
  <link rel="icon" href={`${B}favicon.svg`} type="image/svg+xml">
  <!-- Шрифты — локально (@fontsource): без запросов к Google (152-ФЗ, скорость в РФ). Заголовок и текст — заранее. -->
  <link rel="preload" href={unbounded700} as="font" type="font/woff2" crossorigin>
  <link rel="preload" href={unbounded500} as="font" type="font/woff2" crossorigin>
  <link rel="preload" href={manrope400} as="font" type="font/woff2" crossorigin>
  <slot name="head" />
  <script type="application/ld+json" set:html={JSON.stringify([org, ...schema])} />
  {ym && (
    <script is:inline define:vars={{ ym }}>
      // Яндекс Метрика (официальный код). Вебвизор выключен: записи сессий не ведём — меньше персональных данных.
      (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();
      for (var j = 0; j < document.scripts.length; j++) { if (document.scripts[j].src === r) { return; } }
      k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
      (window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');
      window.ym(Number(ym), 'init', { clickmap: true, trackLinks: true, accurateTrackBounce: true, webvisor: false });
    </script>
  )}
</head>
<body>
  <header class="bar">
    <a href={B} class="logo" aria-label={`${brand.name} — на главную`}>
      <svg width="30" height="30" viewBox="0 0 34 34" fill="none" stroke="#E8B04B" stroke-width="2.2" aria-hidden="true"><circle cx="11" cy="17" r="7"/><path d="M18 17h14M27 17v6M31 17v4"/></svg>
      {brand.name}
    </a>
    <nav class="bar-links" aria-label="Контакты">
      <a href={brand.phoneHref} class="hide-sm">{brand.phone}</a>
      <a href={brand.telegram} rel="noopener">Telegram</a>
      <slot name="bar" />
    </nav>
  </header>
  <slot />
  {ym && (
    <div class="cookie" id="cookie" hidden>
      <span>Сайт использует cookie и Яндекс Метрику для статистики. <a href={`${B}privacy/`}>Подробнее</a></span>
      <button type="button" id="cookie-ok">Понятно</button>
    </div>
    <script is:inline>
      (function () {
        var c = document.getElementById('cookie'); if (!c) return;
        try { if (localStorage.getItem('ks_cookie') === '1') return; } catch (e) {}
        // на главной — после заставки, чтобы не спорить с трейлером
        setTimeout(function () { c.hidden = false; }, document.documentElement.classList.contains('trailer-on') ? 9000 : 1200);
        document.getElementById('cookie-ok').addEventListener('click', function () { c.hidden = true; try { localStorage.setItem('ks_cookie', '1'); } catch (e) {} });
      })();
    </script>
  )}
</body>
</html>
