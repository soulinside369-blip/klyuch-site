---
// Кинетическая типографика: текст → слова (не рвутся при переносе) → буквы с индексом --i для волновой задержки.
// Экранные читалки получают целую фразу (aria-label), буквы скрыты от них.
interface Props { text: string; class?: string; start?: number; }
const { text, class: cls = '', start = 0 } = Astro.props;
let n = start;
const words = text.split(' ').map((w) => [...w].map((ch) => ({ ch, i: n++ })));
---
<span class={`split ${cls}`} aria-label={text} role="text">{words.map((w, k) => (
  <><span class="w" aria-hidden="true">{w.map((c) => <span class="ch" style={`--i:${c.i}`}>{c.ch}</span>)}</span>{k < words.length - 1 && ' '}</>
))}</span>
